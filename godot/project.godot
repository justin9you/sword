; 诛仙 3D —— Godot 工程配置。
;
; 这个文件 Godot 自己会改（打开编辑器、调设置都会写它），所以别指望它保持手写的样子。
; 真正要紧的只有三行：主场景、程序集名、features 里的版本号。
;
; 主场景是 3D 游戏本体（main.tscn）。冒烟测试挪到了 smoke.tscn，
; 由 npm run smoke:godot 显式指定场景去跑——它验的是逻辑层，不需要画面。

config_version=5

[application]

config/name="诛仙 · 江湖录 3D"
config/description="网页版《诛仙 · 江湖录》的 3D 版本。数据和玩法逻辑与网页版共用同一份源码。"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="Zhuxian3D"

[rendering]

textures/canvas_textures/default_texture_filter=0
