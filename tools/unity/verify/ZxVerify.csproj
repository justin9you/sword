<!--
  只为「编译得过吗」这一个问题存在的工程，不产出任何要用的东西。

  ZxData.cs 是生成的，生成器改一行就可能吐出编译不过的代码（类名撞车、字段名撞
  关键字、类型推歪）——那种错在 Unity 里要等导入资源才炸，绕一大圈。这里 dotnet
  build 一下就知道，顺便让 VS Code 的 C# Dev Kit 认得这些文件，有补全和红波浪线。

  TargetFramework 和 LangVersion 对齐 Unity 2021+ 的 .NET Standard 2.1 / C# 9，
  免得这边过了、Unity 那边用了更新的语法反而不认。
  UnityEngine 用同目录下的 UnityStub.cs 顶着，它绝不能进 export/。

    npm run verify:unity
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ZxVerify</AssemblyName>
    <RootNamespace>Zhuxian.Verify</RootNamespace>
    <!-- 编译产物是一次性的，不进版本库 -->
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <!-- 警告当错误：生成器吐出可疑代码时别让它悄悄过 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 待检对象：导出的那两个 .cs -->
    <Compile Include="..\..\..\export\unity\Runtime\*.cs" />
  </ItemGroup>

</Project>
