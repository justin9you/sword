<!--
  只为「编译得过吗」这一个问题存在的工程，不产出任何要用的东西。

  编的是 Godot 用户真正会拖进项目的那一套：引擎无关的数据类 + Godot 适配器 +
  整个 Zhuxian.Core。少了任何一块都编不过，所以这一步顺带验证了
  「Core 能被 Godot 侧引用」这件事。

  TargetFramework 用 net7.0 是因为这台机器只有 .NET 7 SDK；Godot 4.2+ 的工程
  实际是 net8.0。代码本身不挑框架，所以这个差别不影响结论。

    npm run verify:godot
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>ZxGodotVerify</AssemblyName>
    <RootNamespace>Zhuxian.Verify</RootNamespace>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 待检对象：数据类 + Godot 适配器 -->
    <Compile Include="..\..\..\export\data\ZxData.cs" />
    <Compile Include="..\..\..\export\godot\*.cs" />
    <!-- 逻辑层：Godot 侧的冒烟脚本要用到它 -->
    <Compile Include="..\..\..\csharp\Zhuxian.Core\*.cs" />
  </ItemGroup>

</Project>
