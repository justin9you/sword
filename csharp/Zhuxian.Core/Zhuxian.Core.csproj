<!--
  移植过来的游戏逻辑层。纯计算，不引用 UnityEngine——
  这样它既能被 Unity 直接吃（netstandard2.1 / C# 9 是 Unity 2021+ 的口径），
  也能被普通的 dotnet 测试工程跑，不用装 Unity 就能验对错。

  数据类不在这里重复定义，直接编译 export/ 下生成的那份，保证只有一个真相。
  ZxDatabase.cs 不编进来：它依赖 UnityEngine，读数据是 Unity（或测试工程）的事。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Zhuxian.Core</AssemblyName>
    <RootNamespace>Zhuxian.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\export\unity\Runtime\ZxData.cs" Link="Generated\ZxData.cs" />
  </ItemGroup>

</Project>
